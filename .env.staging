# Apunta al ambiente STAGING del ERP (https://staging.erp.opensys.cl).
# Para activarlo en local: `cp .env.staging .env && npx expo start --clear`.
# Para builds EAS: definí estos valores en eas.json (profile staging).

EXPO_PUBLIC_API_URL=https://staging.erp.opensys.cl

# Tenant resolution: el backend espera el header X-Tenant: {slug} con cada request
EXPO_PUBLIC_TENANT_MODE=header

# Realtime · Laravel Reverb (ws). El staging y prod comparten el mismo broker
# expuesto en ws.erp.opensys.cl (HTTPS/WSS 443 → 127.0.0.1:8080 vía Apache proxy).
# El APP_KEY 'prod-key' coincide con config/reverb.php del backend staging.
EXPO_PUBLIC_REVERB_HOST=ws.erp.opensys.cl
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https
EXPO_PUBLIC_REVERB_KEY=prod-key

# Opcionales — completá si los usás
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
