# API base URL (sin trailing slash). Para desarrollo local con un emulador apunta a tu IP LAN.
EXPO_PUBLIC_API_URL=https://app.opensys.cl

# Modo de resolución de tenant: "subdomain" | "header"
# - subdomain: el cliente arma {tenant}.opensys.cl para cada request
# - header: usa EXPO_PUBLIC_API_URL fijo y manda X-Tenant: {slug}
EXPO_PUBLIC_TENANT_MODE=header

# Realtime (Laravel Reverb / Pusher protocol)
# El ERP corre Reverb (laravel/reverb 1.10) — estos valores deben coincidir con
# config/reverb.php del backend. La REVERB_KEY es pública por diseño (no es secreto).
EXPO_PUBLIC_REVERB_HOST=app.opensys.cl
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https
EXPO_PUBLIC_REVERB_KEY=

# Sentry / posthog opcionales
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
